# RAKSHYA Backend Environment Configuration
# Copy this file to .env and fill in production secrets

# Server Configuration (Cloud Run injects PORT automatically; default: 3001)
PORT=3001
NODE_ENV=production

# Database: External PostgreSQL connection string (e.g. from Neon.tech, Supabase, or Render PostgreSQL)
# Required in production. Embedded PGlite is disabled in production to stay within 512MB RAM limits.
DATABASE_URL=postgresql://user:password@ep-sample.aws.neon.tech/rakshya?sslmode=require

# Authentication (JWT Secret and Expiration)
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# Google Gemini AI (Optional - leave empty to use built-in heuristic security engine)
GEMINI_API_KEY=

# Frontend URLs for CORS (comma-separated if multiple)
FRONTEND_URL=https://rakshya-ai.vercel.app,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

